{
  "name": "anybridge",
  "version": "0.5.39",
  "description": "Open-source desktop BYOK bridge for AI coding tools",
  "type": "module",
  "main": "sidecar/proxy-entry.js",
  "author": "soulvon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soulvon/AnyBridge.git"
  },
  "bugs": {
    "url": "https://github.com/soulvon/AnyBridge/issues"
  },
  "homepage": "https://github.com/soulvon/AnyBridge#readme",
  "scripts": {
    "start": "node sidecar/proxy-entry.js",
    "start:proxy": "node sidecar/hybrid-server.js",
    "start:inference": "node sidecar/inference-proxy.js",
    "start:both": "node sidecar/proxy-entry.js",
    "dev": "node --watch sidecar/proxy-entry.js",
    "dev:proxy": "node --watch sidecar/hybrid-server.js",
    "dev:inference": "node --watch sidecar/inference-proxy.js",
    "build:ui": "node scripts/build-ui.mjs",
    "build:ui:watch": "node scripts/build-ui.mjs --watch",
    "build:desktop": "npm run check:rust && npm run build:ui && npm run build:cursor-core",
    "check:rust": "node scripts/check-rust-toolchain.mjs",
    "build:cursor-core": "npm run check:rust && python scripts/build/build_cursor_core.py",
    "check:cursor-core": "npm run check:rust && cargo check --config \"build.jobs=1\" --config \"build.incremental=false\" --manifest-path cursor-core/Cargo.toml --lib",
    "check:cursor": "node scripts/check-cursor-proxy.mjs",
    "check:ui": "node scripts/check-ui.mjs",
    "test:unit": "node --test scripts/test-healthcheck.mjs sidecar/lib/log-rate-limit.test.js sidecar/lib/tls-diagnostics.test.js",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --lib",
    "tauri": "tauri",
    "tauri:dev": "npm run check:rust && tauri dev",
    "tauri:build": "npm run check:rust && node scripts/build/tauri_build.mjs",
    "tauri:build:local": "npm run check:rust && node scripts/build/tauri_build.mjs --config src-tauri/tauri.local.conf.json"
  },
  "keywords": [
    "anybridge",
    "byok",
    "tauri",
    "desktop",
    "ai-tools",
    "llm",
    "anthropic",
    "openai-compatible",
    "proxy",
    "connect-rpc",
    "protobuf"
  ],
  "license": "MIT",
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "jsdom": "^27.0.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
