{
  "apiVersion": 1,
  "id": "aistudio2api",
  "name": "AIStudio2API",
  "short": "AS",
  "accent": "#1a73e8",
  "description": "把 Google AI Studio 账户转成 OpenAI、Responses、Anthropic 与 Gemini 兼容接口：多账户轮询、Web 控制台管理账户与用量。",
  "version": "1.0.0",
  "icon": "icon.svg",
  "category": "api-gateway",
  "homepage": "https://github.com/Mag1cFall/AIStudio2API",
  "runtime": {
    "type": "binary",
    "binary": "aistudio2api{ext}",
    "args": [
      "-open-ui=false"
    ],
    "workdir": "{installPath}",
    "port": "{config.port}",
    "stopSignal": "SIGTERM",
    "stopTimeout": 30000,
    "env": {}
  },
  "healthCheck": {
    "type": "http",
    "url": "http://127.0.0.1:{port}/health",
    "method": "GET",
    "expectStatus": 200,
    "intervalSeconds": 30,
    "timeoutSeconds": 3,
    "healthyThreshold": 2,
    "unhealthyThreshold": 3
  },
  "configSchema": [
    {
      "key": "port",
      "label": "监听端口",
      "type": "number",
      "default": 2048,
      "required": true,
      "description": "管理与 API 共用的监听端口（上游默认 2048）。改动后需要「重新生成配置文件」再重启",
      "hidden": false,
      "generate": null,
      "immutable": false
    },
    {
      "key": "apiKey",
      "label": "API 密钥",
      "type": "password",
      "default": "",
      "required": true,
      "description": "首次安装由 AnyBridge 生成，写入 .env 的 PROXY_API_KEY 并登记为本地供应商；改动后需重新生成配置文件",
      "hidden": false,
      "generate": "base64-32",
      "immutable": false
    }
  ],
  "capabilities": [
    "lifecycle",
    "health-check",
    "logs"
  ],
  "panels": [
    {
      "id": "overview",
      "title": "概览",
      "type": "builtin",
      "order": 1,
      "fields": [
        {
          "key": "status",
          "label": "状态",
          "type": "status-light"
        },
        {
          "key": "port",
          "label": "端口",
          "type": "text"
        },
        {
          "key": "version",
          "label": "版本",
          "type": "text"
        },
        {
          "key": "uptime",
          "label": "运行时间",
          "type": "duration"
        }
      ]
    },
    {
      "id": "gateway",
      "title": "网关状态",
      "type": "builtin",
      "order": 2,
      "capability": "health-check",
      "requiresAuth": false,
      "loadFrom": "getGatewayStatus",
      "actions": [
        {
          "id": "openConsole",
          "label": "打开管理控制台",
          "type": "button",
          "confirm": false,
          "method": "openConsole"
        },
        {
          "id": "switchVersion",
          "label": "切换版本",
          "type": "prompt",
          "promptLabel": "目标版本（如 v0.3.1）",
          "confirm": false,
          "method": "switchVersion"
        }
      ],
      "fields": [
        {
          "key": "service",
          "label": "服务名",
          "type": "text"
        },
        {
          "key": "state",
          "label": "生成服务",
          "type": "text"
        },
        {
          "key": "apiBase",
          "label": "API 地址",
          "type": "text"
        },
        {
          "key": "version",
          "label": "网关版本",
          "type": "text"
        },
        {
          "key": "models",
          "label": "可用模型",
          "type": "number"
        },
        {
          "key": "apiKey",
          "label": "API 密钥",
          "type": "text"
        }
      ]
    },
    {
      "id": "logs",
      "title": "日志",
      "type": "builtin",
      "order": 3,
      "capability": "logs"
    }
  ],
  "deploy": {
    "strategies": [
      "adapter"
    ],
    "asset": {
      "repo": "Mag1cFall/AIStudio2API",
      "name": "aistudio2api-{tag}-{goos}-{goarch}.{archive_ext}",
      "binary": "aistudio2api{ext}",
      "versionFile": ".aistudio2api-version",
      "stripComponents": 1
    },
    "adapter": {
      "doc": "deploy.md",
      "installer": "adapter.js",
      "minDiskMB": 200,
      "estimatedTime": "1-2min",
      "requiresNetwork": true,
      "requiresAdmin": false
    }
  },
  "upgrade": {
    "type": "github-release",
    "repo": "Mag1cFall/AIStudio2API",
    "checkInterval": "24h",
    "autoCheck": true
  },
  "credentials": [
    {
      "subtitle": "AIStudio2API (OpenAI 兼容)",
      "rows": [
        {
          "label": "API Key",
          "value": "{config.apiKey}",
          "copy": true
        },
        {
          "label": "API 地址",
          "value": "http://127.0.0.1:{port}/v1",
          "copy": true
        },
        {
          "label": "Anthropic 地址",
          "value": "http://127.0.0.1:{port}",
          "copy": true
        },
        {
          "label": "Gemini 地址",
          "value": "http://127.0.0.1:{port}/v1beta",
          "copy": true
        }
      ]
    },
    {
      "subtitle": "AIStudio2API 管理控制台",
      "rows": [
        {
          "label": "访问模式",
          "value": "本机访问免登录（打开控制台即进入）"
        },
        {
          "label": "面板地址",
          "value": "http://127.0.0.1:{port}/",
          "copy": true
        }
      ]
    }
  ]
}
