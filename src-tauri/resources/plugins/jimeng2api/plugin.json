{
  "apiVersion": 1,
  "id": "jimeng2api",
  "name": "Jimeng2API",
  "short": "JM",
  "accent": "#1261A6",
  "description": "即梦多账号 API 网关，兼容 OpenAI 图像与视频接口",
  "version": "1.2.6",
  "icon": "icon.svg",
  "category": "api-gateway",
  "author": "zhizinan1997",
  "homepage": "https://github.com/zhizinan1997/jimeng-free-api-all",
  "license": "GPL-3.0",
  "runtime": {
    "type": "nodejs",
    "args": ["dist/index.js"],
    "workdir": "{installPath}",
    "port": "{config.port}",
    "stopSignal": "SIGTERM",
    "stopTimeout": 15000
  },
  "healthCheck": {
    "type": "http",
    "url": "http://127.0.0.1:{port}/v1/models",
    "method": "GET",
    "expectStatus": 200,
    "intervalSeconds": 30,
    "timeoutSeconds": 5,
    "healthyThreshold": 2,
    "unhealthyThreshold": 3
  },
  "configSchema": [
    {
      "key": "port",
      "label": "监听端口",
      "type": "number",
      "default": 5566,
      "required": true,
      "description": "本地服务监听端口",
      "hidden": false,
      "generate": null,
      "immutable": false
    },
    {
      "key": "accountPoolKey",
      "label": "账号池主加密密钥",
      "type": "string",
      "default": "",
      "required": true,
      "description": "账号池 AES-256 加密密钥（保护即梦 Cookie，首次生成后请勿修改）",
      "hidden": true,
      "generate": "base64-32",
      "immutable": true
    },
    {
      "key": "timezone",
      "label": "服务时区",
      "type": "string",
      "default": "Asia/Shanghai",
      "required": false,
      "description": "服务日志与调度时区",
      "hidden": false,
      "generate": null,
      "immutable": false
    }
  ],
  "capabilities": [
    "lifecycle",
    "health-check",
    "logs"
  ],
  "panels": [
    {
      "id": "overview",
      "title": "概览",
      "type": "builtin",
      "order": 1,
      "fields": [
        { "key": "status", "label": "运行状态", "type": "status-light" },
        { "key": "port", "label": "监听端口", "type": "text" },
        { "key": "version", "label": "服务版本", "type": "text" },
        { "key": "uptime", "label": "在线时长", "type": "duration" }
      ]
    },
    {
      "id": "logs",
      "title": "日志",
      "type": "builtin",
      "order": 2,
      "capability": "logs"
    }
  ],
  "deploy": {
    "strategies": ["source"],
    "source": {
      "doc": "deploy.md",
      "installer": "adapter.js",
      "minDiskMB": 300,
      "estimatedTime": "2-5min",
      "requiresNetwork": true,
      "requiresAdmin": false
    }
  },
  "upgrade": {
    "type": "git-pull",
    "repo": "zhizinan1997/jimeng-free-api-all"
  }
}
