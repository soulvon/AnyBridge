#!/bin/sh
# 关键功能回归检查 —— 不通过不允许提交。
#
# 背景：项目多次出现「改 A 导致 B 回归」「上次修的下次又坏」，
# 因此把回归检查前置到提交环节，让沉淀的坑点真正反馈到工作流
# （而不是只写在文档里）。
#
# 安装： cp scripts/hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# 绕过（仅紧急）： git commit --no-verify

cd "$(git rev-parse --show-toplevel)" || exit 0

if ! command -v node >/dev/null 2>&1; then
  echo "⚠ 未找到 node，跳过回归检查"
  exit 0
fi

node scripts/check-key-features.mjs
status=$?

if [ $status -ne 0 ]; then
  echo ""
  echo "❌ 回归检查未通过，提交已阻止。"
  echo "   请修复失败项后重新提交。"
  echo "   紧急绕过： git commit --no-verify"
  exit 1
fi

exit 0
