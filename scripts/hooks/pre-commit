#!/bin/sh
# 提交前运行快速、确定性的检查；失败时阻止提交。
# 安装：cp scripts/hooks/pre-commit .git/hooks/pre-commit

cd "$(git rev-parse --show-toplevel)" || {
  echo "无法定位仓库根目录，提交已阻止。"
  exit 1
}

if ! command -v node >/dev/null 2>&1; then
  echo "未找到 Node.js，无法执行提交检查，提交已阻止。"
  exit 1
fi

node scripts/check-ui.mjs && node scripts/check-key-features.mjs --fast
status=$?
if [ $status -ne 0 ]; then
  echo "提交检查未通过，提交已阻止。请修复后重新提交。"
  exit 1
fi

exit 0
